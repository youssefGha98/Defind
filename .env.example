# Minimal setup for the CLI in local mode.
# The CLI always receives rpc_url, address, start_block, protocol_slug and contract_slug as flags.

# Recommended for automatic ABI fetch from Etherscan.
ETHERSCAN_API_KEY=

# Local output root when using: defind run --storage local
DEFIND_API_OUT_ROOT=./data

# Optional Etherscan endpoint override.
DEFIND_API_ETHERSCAN_API_URL=https://api.etherscan.io/v2/api

# S3 storage settings.
# Only needed when using: defind run --storage s3
S3_BUCKET=defind
S3_PREFIX=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Optional S3 retry tuning.
DEFIND_API_S3_MAX_RETRIES=3
DEFIND_API_S3_RETRY_BACKOFF_S=0.5
